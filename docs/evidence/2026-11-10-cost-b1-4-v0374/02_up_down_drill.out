===== 4. ★ 快照：唯一索引谓词（uk_biz_cost_std 必须带软删条件） =====
idx_biz_cost_var_obj :: CREATE INDEX idx_biz_cost_var_obj ON public.biz_cost_variance USING btree (cost_object_id, period_code)
idx_biz_cost_var_period :: CREATE INDEX idx_biz_cost_var_period ON public.biz_cost_variance USING btree (period_code, variance_type)
uk_biz_cost_std :: CREATE UNIQUE INDEX uk_biz_cost_std ON public.biz_cost_standard USING btree (material_id, effective_from) WHERE (deleted_at IS NULL)
uk_biz_cost_std_item :: CREATE UNIQUE INDEX uk_biz_cost_std_item ON public.biz_cost_standard_item USING btree (standard_id, line_no)

===== 5. 快照：列精度（标准价/费率 18,6；差异金额 18,4；标准工时 18,4） =====
biz_cost_standard.std_labor_cost = numeric(18,6)
biz_cost_standard.std_labor_hours = numeric(18,4)
