diff --git a/frontend/src/views/business/hr/certificate/index.vue b/frontend/src/views/business/hr/certificate/index.vue
new file mode 100644
index 00000000..95b55a68
--- /dev/null
+++ b/frontend/src/views/business/hr/certificate/index.vue
@@ -0,0 +1,249 @@
+<!--
+  证书台账页（HR-50 新人走查骨架 · 照 `docs/前端二开指南.md` §11.1 ③ 抄，骨架里的空洞
+  —— `form` / `rules` / `submit` / `employeeOptions` —— 按 leave 页的做法补上）。
+
+  data-testid 全量：单测与 E2E 只认 `data-testid`，不认 class 与文案。
+-->
+<template>
+  <div class="page">
+    <!-- ① 页面头 -->
+    <t-card :bordered="false" class="page-head">
+      <div class="page-head__main">
+        <h2 class="page-head__title">证书台账</h2>
+        <p class="page-head__desc">说明文字放这里，别塞进菜单 title（AGENTS.md 约定 12）</p>
+      </div>
+      <div class="page-head__actions">
+        <t-button variant="outline" data-testid="hr-certificate-refresh" @click="loadRows">刷新</t-button>
+        <t-button
+          v-if="canCreate"
+          theme="primary"
+          data-testid="hr-certificate-create"
+          @click="openCreate"
+        >
+          <template #icon><t-icon name="add" /></template>
+          新建
+        </t-button>
+      </div>
+    </t-card>
+
+    <!-- ② 筛选 -->
+    <t-card :bordered="false" class="filter-card">
+      <div class="filter-row">
+        <t-input
+          v-model="filter.keyword"
+          class="filter-row__keyword"
+          placeholder="编号"
+          clearable
+          data-testid="hr-certificate-keyword"
+          @enter="handleSearch"
+          @clear="handleSearch"
+        >
+          <template #prefix-icon><t-icon name="search" /></template>
+        </t-input>
+        <t-select
+          v-model="filter.status"
+          class="filter-row__select"
+          :options="statusOptions"
+          placeholder="全部状态"
+          multiple
+          clearable
+          data-testid="hr-certificate-filter-status"
+        />
+        <t-button theme="primary" data-testid="hr-certificate-search" @click="handleSearch">查询</t-button>
+        <t-button variant="outline" data-testid="hr-certificate-reset" @click="handleReset">重置</t-button>
+      </div>
+    </t-card>
+
+    <!-- ③ 列表 -->
+    <t-card :bordered="false" class="list-card">
+      <t-alert v-if="loadError" theme="error" :message="loadError" data-testid="hr-certificate-load-error" />
+      <t-table
+        row-key="id"
+        :data="rows"
+        :columns="columns"
+        :loading="loading"
+        :pagination="pagination"
+        hover
+        data-testid="hr-certificate-table"
+        @page-change="handlePageChange"
+      >
+        <template #status="{ row }">
+          <t-tag :theme="row.status === 'ACTIVE' ? 'success' : 'default'">{{ row.status_label }}</t-tag>
+        </template>
+      </t-table>
+    </t-card>
+
+    <!-- ④ 抽屉表单：新建 -->
+    <t-drawer
+      v-model:visible="drawerVisible"
+      header="新建证书"
+      size="560px"
+      :confirm-btn="{ content: '保存', disabled: submitting }"
+      @confirm="submit"
+    >
+      <t-form ref="formRef" :data="form" :rules="rules" label-width="96px">
+        <t-form-item label="员工" name="employee_id">
+          <t-select
+            v-model="form.employee_id"
+            :options="employeeOptions"
+            filterable
+            data-testid="hr-certificate-form-employee"
+          />
+        </t-form-item>
+        <t-form-item label="证书类型" name="cert_type">
+          <t-select v-model="form.cert_type" :options="certTypeOptions" data-testid="hr-certificate-form-type" />
+        </t-form-item>
+        <t-form-item label="编号" name="no">
+          <t-input v-model="form.no" data-testid="hr-certificate-form-no" />
+        </t-form-item>
+        <t-form-item label="发证日" name="issue_date">
+          <t-date-picker v-model="form.issue_date" data-testid="hr-certificate-form-issue" />
+        </t-form-item>
+      </t-form>
+      <template #footer>
+        <t-button variant="outline" @click="drawerVisible = false">取消</t-button>
+        <t-button
+          theme="primary"
+          :loading="submitting"
+          data-testid="hr-certificate-form-submit"
+          @click="submit"
+        >保存</t-button>
+      </template>
+    </t-drawer>
+  </div>
+</template>
+
+<script setup lang="ts">
+import { computed, onMounted, reactive, ref } from 'vue';
+import { MessagePlugin } from 'tdesign-vue-next';
+import { useUserStore } from '@/stores/user';
+import {
+  CERT_COLUMNS as columns,
+  CERT_PERMS,
+  CERT_TYPE_LABELS,
+  CERT_TYPE_VALUES,
+  STATUS_LABELS,
+  STATUS_VALUES,
+  emptyFilter,
+  type CertificateFilter,
+  type CertificateListRow,
+} from '@/api/business/hr/certificate';
+import { createCertificate, fetchCertificatePage } from '@/api/business/hr/certificate';
+
+/**
+ * 页面显形码在路由 `meta.permission`（决定「进不进得来」），
+ * 按钮判据用**接口码**（决定「这个动作做不做得了」）—— 两者已解耦（编码规范 §1.7.2）。
+ */
+const userStore = useUserStore();
+const canCreate = computed(() => userStore.hasPermission(CERT_PERMS.create));
+
+const rows = ref<CertificateListRow[]>([]);
+const total = ref(0);
+const page = ref(1);
+const pageSize = ref(20);
+const loading = ref(false);
+const loadError = ref('');
+
+/** 分页交给 `t-table` 的 `:pagination`（本仓所有列表页都这么写：不单独放 t-pagination） */
+const pagination = computed(() => ({
+  current: page.value,
+  pageSize: pageSize.value,
+  total: total.value,
+  showJumper: true,
+  showPageSize: false,
+}));
+
+function handlePageChange(pageInfo: { current: number; pageSize: number }): void {
+  page.value = pageInfo.current;
+  if (pageInfo.pageSize && pageInfo.pageSize !== pageSize.value) {
+    pageSize.value = pageInfo.pageSize;
+  }
+  void loadRows();
+}
+
+const filter = reactive<CertificateFilter>(emptyFilter());
+const statusOptions = computed(() =>
+  STATUS_VALUES.map((value) => ({ label: STATUS_LABELS[value], value })),
+);
+const certTypeOptions = computed(() =>
+  CERT_TYPE_VALUES.map((value) => ({ label: CERT_TYPE_LABELS[value], value })),
+);
+
+/** 唯一取数入口：筛选序列化 / 分页都收在这里，别在模板里拼 query */
+async function loadRows(): Promise<void> {
+  loading.value = true;
+  loadError.value = '';
+  try {
+    const data = await fetchCertificatePage({ ...filter, page: page.value, page_size: pageSize.value });
+    // PageData 的字段是 `list` / `total`（不是 items / meta —— 写错就是永远空表）
+    rows.value = data.list ?? [];
+    total.value = data.total ?? 0;
+  } catch (error) {
+    loadError.value = (error as Error).message || '加载失败';
+  } finally {
+    loading.value = false;
+  }
+}
+
+function handleSearch(): void {
+  page.value = 1;
+  void loadRows();
+}
+
+function handleReset(): void {
+  Object.assign(filter, emptyFilter());
+  handleSearch();
+}
+
+onMounted(loadRows);
+
+// ==================== 抽屉（骨架里的空洞按 leave 页补全） ====================
+
+interface CertificateForm {
+  employee_id: string;
+  cert_type: string;
+  no: string;
+  issue_date: string;
+}
+
+const drawerVisible = ref(false);
+const submitting = ref(false);
+const formRef = ref();
+const form = reactive<CertificateForm>({ employee_id: '', cert_type: 'SKILL', no: '', issue_date: '' });
+
+/** 员工下拉：本页只用到「选一个员工」，数据来自员工档案页的列表接口 */
+const employeeOptions = ref<{ label: string; value: string }[]>([]);
+
+const rules = {
+  employee_id: [{ required: true, message: '请选择员工', type: 'error' as const }],
+  cert_type: [{ required: true, message: '请选择证书类型', type: 'error' as const }],
+  no: [{ required: true, message: '请填编号', type: 'error' as const }],
+  issue_date: [{ required: true, message: '请选发证日', type: 'error' as const }],
+};
+
+function openCreate(): void {
+  form.employee_id = '';
+  form.cert_type = 'SKILL';
+  form.no = '';
+  form.issue_date = '';
+  drawerVisible.value = true;
+}
+
+async function submit(): Promise<void> {
+  const result = await formRef.value?.validate();
+  if (result !== true) {
+    return;
+  }
+  submitting.value = true;
+  try {
+    await createCertificate({ ...form });
+    MessagePlugin.success('已保存');
+    drawerVisible.value = false;
+    await loadRows();
+  } catch (error) {
+    MessagePlugin.error((error as Error).message || '保存失败');
+  } finally {
+    submitting.value = false;
+  }
+}
+</script>
diff --git a/frontend/tests/unit/hr-certificate-page.test.ts b/frontend/tests/unit/hr-certificate-page.test.ts
new file mode 100644
index 00000000..5105d11b
--- /dev/null
+++ b/frontend/tests/unit/hr-certificate-page.test.ts
@@ -0,0 +1,29 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+import { STATUS_LABELS, STATUS_VALUES } from '../../src/api/business/hr/certificate-kinds';
+
+/** 后端 DTO 源码 = 词表的唯一真相：后端加一个码值而前端没跟，这里先红 */
+const DTO_SRC = readFileSync(
+  new URL('../../../backend/src/business/hr/certificate_dto.rs', import.meta.url),
+  'utf8',
+);
+
+test('状态词表与后端 DTO 逐值一致', () => {
+  for (const value of STATUS_VALUES) {
+    assert.match(DTO_SRC, new RegExp(`"${value}"`), `后端 DTO 里找不到状态 ${value}`);
+    assert.ok(STATUS_LABELS[value], `${value} 缺中文标签`);
+    assert.match(DTO_SRC, new RegExp(STATUS_LABELS[value]), `后端 DTO 里找不到中文标签 ${STATUS_LABELS[value]}`);
+  }
+});
+
+test('页面显形码用 *:page，且不进后端源码', () => {
+  const router = readFileSync(new URL('../../src/router/index.ts', import.meta.url), 'utf8');
+  assert.match(router, /business:hr:certificate:page/);
+  const dto = readFileSync(
+    new URL('../../../backend/src/business/hr/certificate_dto.rs', import.meta.url),
+    'utf8',
+  );
+  assert.ok(!dto.includes('business:hr:certificate:page'), '页面码不许出现在后端源码里');
+});
