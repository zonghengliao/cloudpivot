+/** 证书台账 API 层（HR-50 走查骨架 · 照 `docs/前端二开指南.md` §11.1 ② 抄）。 */
+import { get, post, type PageData } from '@/api/request';
+import type { CertificateListRow } from './certificate-kinds';
+
+export * from './certificate-kinds';
+
+/** 后端注解不含 `/api`（`[router].prefix` 注入）；漏了会命中 SPA fallback 返回 HTML → 「响应体格式不符合」 */
+const BASE = '/api/business/hr/certificate';
+
+/** 列表（后端分页包装 `PageData<T>`：字段是 `list` / `total` / `page` / `page_size`） */
+export const fetchCertificatePage = (params: Record<string, unknown>) =>
+  get<PageData<CertificateListRow>>(`${BASE}/page`, params);
+
+/** 详情 */
+export const fetchCertificate = (id: string) => get<CertificateListRow>(`${BASE}/${id}`);
+
+/** 新建（编号留空 ⇒ 后端取号） */
+export const createCertificate = (body: Record<string, unknown>) => post<{ id: string }>(BASE, body);
