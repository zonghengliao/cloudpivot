diff --git a/frontend/src/api/business/hr/certificate-kinds.ts b/frontend/src/api/business/hr/certificate-kinds.ts
new file mode 100644
index 00000000..702adc1e
--- /dev/null
+++ b/frontend/src/api/business/hr/certificate-kinds.ts
@@ -0,0 +1,64 @@
+/**
+ * 证书台账的出参契约与词表（HR-50 新人走查骨架 · 照 `docs/前端二开指南.md` §11.1 ① 抄）。
+ *
+ * 纯逻辑文件：**不 import 请求层、不 import Vue** —— `tests/unit/hr-certificate-page.test.ts`
+ * 会 `readFileSync` 后端 `backend/src/business/hr/certificate_dto.rs`，把下面两张表逐值对拍。
+ */
+
+/** 状态域（与 DDL 的 ck_biz_employee_certificate_status 逐字一致） */
+export const STATUS_VALUES = ['ACTIVE', 'EXPIRED', 'REVOKED'] as const;
+export type Status = (typeof STATUS_VALUES)[number];
+
+/** 码值 → 中文（与后端 `certificate_dto.rs` 的 STATUS_LABELS 逐值一致） */
+export const STATUS_LABELS: Record<Status, string> = {
+  ACTIVE: '有效',
+  EXPIRED: '已到期',
+  REVOKED: '已注销',
+};
+
+/** 列表行（键名逐条抄后端 `CertificateListRes`，不缩写） */
+export interface CertificateListRow {
+  id: string;
+  employee_id: string;
+  /** 员工姓名：后端实时 join 下发（主数据改名后显示新名） */
+  employee_name: string;
+  no: string;
+  cert_type: string;
+  status: Status;
+  status_label: string;
+}
+
+/** 权限码表（与 `sys_menu.auth_code` 逐字一致；`page` 只判路由显形，其余判动作） */
+export const CERT_PERMS = {
+  /** 页面显形码：后端零引用，只给路由 `meta.permission`（编码规范 §1.7.2） */
+  page: 'business:hr:certificate:page',
+  /** 全量列表接口的码（挂在按钮行，不是页面行） */
+  list: 'business:hr:certificate:list',
+  detail: 'business:hr:certificate:detail',
+  create: 'business:hr:certificate:create',
+} as const;
+
+/** 筛选条件（`emptyFilter()` 与「重置」共用同一份，避免两处漂移） */
+export interface CertificateFilter {
+  keyword?: string;
+  status?: Status[];
+}
+export function emptyFilter(): CertificateFilter {
+  return { keyword: '', status: [] };
+}
+
+/** 列定义（`status` / `op` 是插槽列，`colKey` 与出参同名） */
+export const CERT_COLUMNS = [
+  { colKey: 'no', title: '编号', width: 150 },
+  { colKey: 'employee_name', title: '员工', width: 120 },
+  { colKey: 'status', title: '状态', width: 90 },
+  { colKey: 'op', title: '操作', width: 140, fixed: 'right' as const },
+];
+
+/** 证书类型（与后端 `CERT_TYPES` 逐值一致） */
+export const CERT_TYPE_VALUES = ['QUALIFICATION', 'SAFETY', 'SKILL'] as const;
+export const CERT_TYPE_LABELS: Record<(typeof CERT_TYPE_VALUES)[number], string> = {
+  QUALIFICATION: '资质证书',
+  SAFETY: '安全证书',
+  SKILL: '技能证书',
+};
