# 快照一致性巡检（B1）目标库配置 —— systemd EnvironmentFile / shell source 两用
#
# 由 /opt/cloudpivot/scripts/cron/snapshot_audit.sh 在启动时 source。
# 权限必须 600（里面是库口令）：chmod 600 /etc/cloudpivot/snapshot-audit.env
#
# ⚠️ 上线前必须改成**生产库**。当前指向本机隔离库 cp_lockorder_t（全量迁移到 V0203、
#    含合同表），只用于验证 cron 通路；生产部署时把 NAME/USER/PASSWORD 换成生产库，
#    否则凌晨巡检扫的是一个夹具库，看板上永远是「全绿」（比不巡检更危险）。
NIK_DATABASE_HOST=<redacted>
NIK_DATABASE_PORT=<redacted>
NIK_DATABASE_USER=<redacted>
NIK_DATABASE_NAME=<redacted>
NIK_DATABASE_PASSWORD=<redacted>

# 有 BLOCKER 时的通知钩子（留空 =<redacted>
# notice::dispatch 是 in-process 的 Rust 函数，没有 CLI 入口；cron 里只能经
# POST /api/business/notice/send 打后端实例（需登录 token、实例在线）。接线时的钩子示例：
# SNAPSHOT_AUDIT_NOTIFY_CMD=<redacted>

