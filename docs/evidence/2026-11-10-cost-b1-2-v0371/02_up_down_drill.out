===== 4. 快照：唯一索引谓词（必须带软删条件） =====
uk_biz_cost_collect_src :: CREATE UNIQUE INDEX uk_biz_cost_collect_src ON public.biz_cost_collect USING btree (source_type, source_id, line_no) WHERE ((deleted_at IS NULL) AND (source_id IS NOT NULL))
uk_biz_cost_rate :: CREATE UNIQUE INDEX uk_biz_cost_rate ON public.biz_cost_rate USING btree (rate_type, scope, COALESCE(scope_id, '00000000-0000-0000-0000-000000000000'::uuid), effective_from) WHERE (deleted_at IS NULL)

===== 5. 快照：外键及其删除动作（confdeltype 必须是 r=RESTRICT） =====
biz_cost_collect -> biz_cost_object confdeltype=r :: FOREIGN KEY (cost_object_id) REFERENCES biz_cost_object(id) ON DELETE RESTRICT
biz_cost_labor -> biz_cost_object confdeltype=r :: FOREIGN KEY (cost_object_id) REFERENCES biz_cost_object(id) ON DELETE RESTRICT
biz_cost_overhead -> biz_cost_object confdeltype=r :: FOREIGN KEY (cost_object_id) REFERENCES biz_cost_object(id) ON DELETE RESTRICT

===== 6. 快照：金额 / 数量列精度（设计 §3.1：金额数量 18,4、单价费率 18,6） =====
biz_cost_collect.amount = numeric(18,4)
biz_cost_collect.qty = numeric(18,4)
biz_cost_collect.unit_price = numeric(18,6)
biz_cost_labor.amount = numeric(18,4)
biz_cost_labor.hours = numeric(10,2)
biz_cost_labor.machine_hours = numeric(10,2)
biz_cost_labor.rate = numeric(18,6)
biz_cost_overhead.amount = numeric(18,4)
biz_cost_rate.rate = numeric(18,6)

===== 7. 卡面「金额 numeric(20,2)」的反证：scale=2 装不下 4 位小数（设计取 18,4 的依据） =====
→ 同一份代码、只把 amount 换成 numeric(20,2)：工资率 33.333333 的工时行（期望 check 违反）
ERROR:  new row for relation "zz_prec_probe" violates check constraint "ck_zz_amount"
DETAIL:  Failing row contains (1.00, 33.333333, 33.33).
scale2_table_rows=0（期望 0 ⇒ 20,2 下真实工资率的工时行插不进去）
→ 同样的数据写进 numeric(18,4) 的 biz_cost_labor（期望成功）：
