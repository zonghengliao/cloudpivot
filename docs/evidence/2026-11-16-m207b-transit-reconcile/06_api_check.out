    M207B-SH4 M207B-M3 wh=M207B-W1 item=10.0000 recv=0 transit=0 diff=10.0000 issues=['CANCELLED_ONLY'] labels=['整批作废：只有在途作废行，不计在途也不计已出']
    M207B-SH3 M207B-M2 wh=None item=20.0000 recv=0 transit=0 diff=20.0000 issues=['MISSING_TRANSIT'] labels=['发货单已过账但没有在途账记录（货发了没进在途）']
