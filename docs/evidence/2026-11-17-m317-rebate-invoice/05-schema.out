-- biz_sales_rebate_settlement 40 列（V0440 加的 5 列 + 2 索引 + 1 CHECK）
                              Table "public.biz_sales_rebate_settlement"
        Column         |           Type           | Collation | Nullable |          Default           
-----------------------+--------------------------+-----------+----------+----------------------------
 id                    | uuid                     |           | not null | gen_random_uuid()
 settlement_no         | character varying(40)    |           | not null | 
 customer_id           | uuid                     |           | not null | 
 settle_period         | character varying(16)    |           | not null | 
 period_code           | character varying(8)     |           | not null | 
 period_from           | date                     |           | not null | 
 period_to             | date                     |           | not null | 
 policy_id             | uuid                     |           | not null | 
 policy_no             | character varying(40)    |           | not null | 
 policy_name           | character varying(200)   |           | not null | 
 rule_type             | character varying(16)    |           | not null | 
 rate_unit             | character varying(16)    |           | not null | 
 policy_effective_from | date                     |           | not null | 
 policy_effective_to   | date                     |           |          | 
 policy_snapshot       | jsonb                    |           | not null | 
 order_count           | integer                  |           | not null | 0
 order_amount          | numeric(18,4)            |           | not null | 0
 order_qty             | numeric(18,4)            |           | not null | 0
 return_count          | integer                  |           | not null | 0
 return_amount         | numeric(18,4)            |           | not null | 0
 return_qty            | numeric(18,4)            |           | not null | 0
 base_amount           | numeric(18,4)            |           | not null | 0
 base_qty              | numeric(18,4)            |           | not null | 0
 tier_seq              | smallint                 |           |          | 
 tier_from             | numeric(18,4)            |           | not null | 0
 tier_to               | numeric(18,4)            |           |          | 
 rate                  | numeric(18,6)            |           | not null | 0
 rebate_amount         | numeric(18,4)            |           | not null | 0
 status                | character varying(16)    |           | not null | 'DRAFT'::character varying
 remark                | text                     |           |          | 
 created_at            | timestamp with time zone |           | not null | CURRENT_TIMESTAMP
 updated_at            | timestamp with time zone |           | not null | CURRENT_TIMESTAMP
 create_by             | uuid                     |           |          | 
 update_by             | uuid                     |           |          | 
 deleted_at            | timestamp with time zone |           |          | 
 invoice_id            | uuid                     |           |          | 
 invoice_no            | character varying(64)    |           |          | 
 voucher_id            | uuid                     |           |          | 
 settled_at            | timestamp with time zone |           |          | 
 settled_by            | uuid                     |           |          | 
Indexes:
    "biz_sales_rebate_settlement_pkey" PRIMARY KEY, btree (id)
    "idx_biz_srs_customer" btree (customer_id, period_code DESC)
    "idx_biz_srs_invoice" btree (invoice_id) WHERE invoice_id IS NOT NULL
    "idx_biz_srs_period" btree (settle_period, period_code)
    "idx_biz_srs_policy" btree (policy_id)
    "idx_biz_srs_status" btree (status)
    "uk_biz_srs_invoice" UNIQUE, btree (invoice_id) WHERE invoice_id IS NOT NULL AND deleted_at IS NULL
    "uk_biz_srs_no" UNIQUE, btree (settlement_no) WHERE deleted_at IS NULL
    "uk_biz_srs_period" UNIQUE, btree (customer_id, settle_period, period_code) WHERE deleted_at IS NULL AND status::text <> 'CANCELLED'::text
Check constraints:
    "ck_biz_srs_amounts" CHECK (order_amount >= 0::numeric AND order_qty >= 0::numeric AND return_amount >= 0::numeric AND return_qty >= 0::numeric AND rebate_amount >= 0::numeric AND rate >= 0::numeric AND tier_from >= 0::numeric)
    "ck_biz_srs_counts" CHECK (order_count >= 0 AND return_count >= 0)
    "ck_biz_srs_period_range" CHECK (period_to > period_from)
    "ck_biz_srs_period_shape" CHECK (settle_period::text = 'MONTH'::text AND period_code::text ~ '^[0-9]{4}-(0[1-9]|1[0-2])$'::text OR settle_period::text = 'QUARTER'::text AND period_code::text ~ '^[0-9]{4}-[Qq][1-4]$'::text)
    "ck_biz_srs_rate_unit" CHECK (rate_unit::text = ANY (ARRAY['PER_UNIT'::character varying, 'PERCENT'::character varying]::text[]))
    "ck_biz_srs_rule_type" CHECK (rule_type::text = ANY (ARRAY['BY_QTY'::character varying, 'BY_AMOUNT'::character varying, 'TIERED'::character varying]::text[]))
    "ck_biz_srs_settle_period" CHECK (settle_period::text = ANY (ARRAY['MONTH'::character varying, 'QUARTER'::character varying]::text[]))
    "ck_biz_srs_settled_link" CHECK (status::text <> 'SETTLED'::text OR invoice_id IS NOT NULL AND invoice_no IS NOT NULL AND settled_at IS NOT NULL)
    "ck_biz_srs_status" CHECK (status::text = ANY (ARRAY['DRAFT'::character varying, 'SETTLED'::character varying, 'CANCELLED'::character varying]::text[]))
    "ck_biz_srs_tier" CHECK ((tier_seq IS NULL OR tier_seq >= 1) AND (tier_to IS NULL OR tier_to > tier_from))
    "ck_biz_srs_unit_pair" CHECK (rule_type::text = 'BY_QTY'::text AND rate_unit::text = 'PER_UNIT'::text OR rule_type::text = 'BY_AMOUNT'::text AND rate_unit::text = 'PERCENT'::text OR rule_type::text = 'TIERED'::text)

-- ck_biz_invoice_source 含 SALES_REBATE
CHECK (((source_type IS NULL) OR ((source_type)::text = ANY ((ARRAY['SALES_ORDER'::character varying, 'SHIPMENT'::character varying, 'SALES_OUT'::character varying, 'MANUAL'::character varying, 'SALES_RETURN'::character varying, 'SALES_REBATE'::character varying])::text[]))))
-- 科目 2241.02
2241.02|其他应付款-佣金|2|1|LIABILITY|CREDIT
