[6] 结转 B（在制 200）→ HTTP 409 code=66107
    msg = 批次 CB-M504PROBE-B 不能完工结转：[WIP_NOT_ZERO] 期末在制数量是 200.0000（不为 0）：分批法按批结转，批没完就一分不转（不做约当产量分摊） ⇒ 等整批完工后再结转；若这批确实允许带在制出货，请走期间结算（calc 约当产量口径）
    data.blockers = [{"code": "WIP_NOT_ZERO", "fix": "等整批完工后再结转；若这批确实允许带在制出货，请走期间结算（calc 约当产量口径）", "message": "期末在制数量是 200.0000（不为 0）：分批法按批结转，批没完就一分不转（不做约当产量分摊）"}]
