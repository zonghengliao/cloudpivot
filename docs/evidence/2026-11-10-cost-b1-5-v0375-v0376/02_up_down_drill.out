===== 3. 结构快照：新列 =====
biz_stock_in.cost_object_id :: uuid nullable=YES default=<无>
biz_stock_in.cost_period_id :: uuid nullable=YES default=<无>
biz_stock_out.cost_object_id :: uuid nullable=YES default=<无>

===== 4. 结构快照：in_type 值域 + 完工入库约束 + 未动的供应商约束 =====
ck_biz_si_production :: CHECK ((((in_type)::text <> 'PRODUCTION'::text) OR ((cost_object_id IS NOT NULL) AND (cost_period_id IS NOT NULL) AND (supplier_id IS NULL) AND (is_sourceless = false))))
ck_biz_si_sourceless_pair :: CHECK (((is_sourceless = (source_order_id IS NULL)) IS TRUE))
ck_biz_si_supplier :: CHECK ((((in_type)::text <> 'PURCHASE'::text) OR (supplier_id IS NOT NULL)))
ck_biz_si_supplier_scope :: CHECK (
CASE
    WHEN ((in_type)::text = ANY ((ARRAY['PURCHASE'::character varying, 'SOURCELESS'::character varying])::text[])) THEN (supplier_id IS NOT NULL)
    ELSE (supplier_id IS NULL)
END)
ck_biz_si_type :: CHECK (((in_type)::text = ANY ((ARRAY['PURCHASE'::character varying, 'RETURN'::character varying, 'OTHER'::character varying, 'SOURCELESS'::character varying, 'PRODUCTION'::character varying])::text[])))

===== 5. 结构快照：三条局部索引 =====
idx_biz_si_cost_obj :: CREATE INDEX idx_biz_si_cost_obj ON public.biz_stock_in USING btree (cost_object_id) WHERE (cost_object_id IS NOT NULL)
idx_biz_si_cost_period :: CREATE INDEX idx_biz_si_cost_period ON public.biz_stock_in USING btree (cost_period_id) WHERE (cost_period_id IS NOT NULL)
idx_biz_so_cost_obj :: CREATE INDEX idx_biz_so_cost_obj ON public.biz_stock_out USING btree (cost_object_id) WHERE (cost_object_id IS NOT NULL)

