=== 2) CHECK 约束（四表全量）
        tbl         |            conname            |                                                                                                                                                                            def                                                                                                                                                                            
--------------------+-------------------------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 biz_inventory      | ck_biz_inv_locked             | CHECK ((locked_qty >= (0)::numeric))
 biz_payable        | ck_biz_payable_amount         | CHECK ((amount >= (0)::numeric))
 biz_payable        | ck_biz_payable_credit         | CHECK ((credit_days >= 0))
 biz_payable        | ck_biz_payable_paid           | CHECK (((paid_amount >= (0)::numeric) AND (paid_amount <= amount)))
 biz_payable        | ck_biz_payable_pending_cancel | CHECK (((deleted_at IS NOT NULL) OR (((status)::text = 'PENDING_CANCEL'::text) AND (cancel_instance_id IS NOT NULL)) OR (((status)::text <> 'PENDING_CANCEL'::text) AND (cancel_instance_id IS NULL))))
 biz_payable        | ck_biz_payable_settled        | CHECK ((((status)::text <> 'SETTLED'::text) OR (unpaid_amount = (0)::numeric)))
 biz_payable        | ck_biz_payable_status         | CHECK (((status)::text = ANY ((ARRAY['OPEN'::character varying, 'PARTIAL_PAID'::character varying, 'SETTLED'::character varying, 'CANCELLED'::character varying, 'PENDING_CANCEL'::character varying])::text[])))
 biz_payable        | ck_biz_payable_unpaid         | CHECK ((unpaid_amount = (amount - paid_amount)))
 biz_purchase_order | ck_biz_po_amount              | CHECK (((total_amount >= (0)::numeric) AND (total_tax >= (0)::numeric) AND (total_with_tax >= (0)::numeric)))
 biz_purchase_order | ck_biz_po_credit              | CHECK ((credit_days >= 0))
 biz_purchase_order | ck_biz_po_price_mode          | CHECK (((price_mode)::text = ANY ((ARRAY['EXCL'::character varying, 'INCL'::character varying])::text[])))
 biz_purchase_order | ck_biz_po_qty                 | CHECK ((total_qty >= (0)::numeric))
 biz_purchase_order | ck_biz_po_status              | CHECK (((status)::text = ANY ((ARRAY['DRAFT'::character varying, 'SUBMITTED'::character varying, 'APPROVED'::character varying, 'PARTIAL_RECEIVED'::character varying, 'RECEIVED'::character varying, 'CLOSED'::character varying, 'CANCELLED'::character varying])::text[])))
 biz_purchase_order | ck_biz_po_tax_sum             | CHECK ((total_with_tax = (total_amount + total_tax)))
 biz_stock_in       | ck_biz_si_pending_cancel      | CHECK (((deleted_at IS NOT NULL) OR (((status)::text = ANY ((ARRAY['PENDING_CANCEL'::character varying, 'PENDING_POST'::character varying])::text[])) AND (approval_instance_id IS NOT NULL)) OR (((status)::text <> ALL ((ARRAY['PENDING_CANCEL'::character varying, 'PENDING_POST'::character varying])::text[])) AND (approval_instance_id IS NULL))))
 biz_stock_in       | ck_biz_si_qty                 | CHECK (((total_qty >= (0)::numeric) AND (total_amount >= (0)::numeric) AND (total_tax >= (0)::numeric) AND (total_with_tax >= (0)::numeric)))
 biz_stock_in       | ck_biz_si_status              | CHECK (((status)::text = ANY ((ARRAY['DRAFT'::character varying, 'POSTED'::character varying, 'PENDING_CANCEL'::character varying, 'PENDING_POST'::character varying, 'CANCELLED'::character varying])::text[])))
 biz_stock_in       | ck_biz_si_supplier            | CHECK ((((in_type)::text <> 'PURCHASE'::text) OR (supplier_id IS NOT NULL)))
 biz_stock_in       | ck_biz_si_tax                 | CHECK ((total_with_tax = (total_amount + total_tax)))
 biz_stock_in       | ck_biz_si_type                | CHECK (((in_type)::text = ANY ((ARRAY['PURCHASE'::character varying, 'RETURN'::character varying, 'OTHER'::character varying])::text[])))
 biz_supplier       | ck_biz_supplier_credit_days   | CHECK ((credit_days >= 0))
 biz_supplier       | ck_biz_supplier_credit_limit  | CHECK ((credit_limit >= (0)::numeric))
(22 rows)

