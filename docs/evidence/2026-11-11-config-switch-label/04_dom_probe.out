# t_f111fef0 真浏览器 DOM 断言记录（vite dev :5199 → 隔离后端 :18052 / 库 costfix_fef0）
# 探针片段（每步都用同一段 JS，返回 {checked, label}）：
#   const it = [...document.querySelectorAll('.config-item')].find(x => x.innerText.includes('<KEY>'));
#   const sw = it.querySelector('.t-switch');
#   return {checked: sw.classList.contains('t-is-checked'), label: sw.innerText.trim()};
# 判定依据：TDesign Switch 的 label[0] 用于 activeValue（checked）态
#   node_modules/tdesign-vue-next/es/switch/switch.mjs:115
#   var label = innerValue.value === activeValue.value ? props2.label[0] : props2.label[1];

