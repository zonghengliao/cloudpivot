++    async fn setup() -> Option<tokio::sync::MutexGuard<'static, ()>> {
++        let guard = DB_LOCK.lock().await;
++        if !ensure_db().await {
++            return None;
++        }
++        cleanup().await;
++        Some(guard)
++    }
