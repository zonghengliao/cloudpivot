+    pub customer_id: Option<String>,
+    /// 下单日期（留空 = 不改）。
+    #[serde(default)]
+    pub order_date: Option<String>,
+    /// 要求交期（传空串 = 清空）。
+    #[serde(default)]
+    pub delivery_date: Option<String>,
+    /// 备注（传空串 = 清空）。
+    #[serde(default)]
+    pub remark: Option<String>,
+    /// 明细（传了就整单替换；不传 = 明细不动）。
