+        // ⑤ SUBMITTED → OUTBOUND（跳步）→ 409
+        let err = change_sales_order_status(
+            None,
+            &created.id,
+            SalesOrderStatusReq {
+                target_status: model::STATUS_OUTBOUND.to_string(),
+                reason: None,
+            },
