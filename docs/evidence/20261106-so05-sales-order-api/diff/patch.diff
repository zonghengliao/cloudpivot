+
+        // ③ 主链：DRAFT → SUBMITTED → APPROVED → OUTBOUND
+        let submitted = change_sales_order_status(
+            None,
+            &created.id,
+            SalesOrderStatusReq {
+                target_status: model::STATUS_SUBMITTED.to_string(),
