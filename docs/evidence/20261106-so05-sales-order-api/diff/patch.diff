++    let rows = ex.query_sql(sql, params).await?;
++    let text: Option<String> = rows.first().and_then(|row| row.get_typed("used").ok());
++    Ok(text
++        .as_deref()
++        .and_then(|value| value.parse::<Decimal>().ok())
++        .unwrap_or(Decimal::ZERO))
++}
