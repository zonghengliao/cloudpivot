+-- ======================================================
+-- V0265 回滚：删掉销售订单的 4 个权限码（先授权行，再菜单行）
+--
+-- 顺序不可交换：`sys_role_menu.menu_id` 挂的是 `sys_menu.id`。
+-- 回滚后 5 个销售订单接口对非超管就是 403 —— 这是预期的（码没了就授不出去），
+-- 但 `biz_sales_order` / `biz_sales_order_item` 里的**数据一行不动**
+-- （表是 V0264 建的，不是本迁移）。
+-- ======================================================
+
+DELETE FROM sys_role_menu
+ WHERE menu_id IN (
+     '20000000-0000-0000-0000-000000002651'::uuid,
+     '20000000-0000-0000-0000-000000002652'::uuid,
+     '20000000-0000-0000-0000-000000002653'::uuid,
+     '20000000-0000-0000-0000-000000002654'::uuid
+ );
+
+-- 先删子（按钮），再删父（页面）：parent_id 无 ON DELETE CASCADE。
+DELETE FROM sys_menu
+ WHERE id IN (
+     '20000000-0000-0000-0000-000000002652'::uuid,
+     '20000000-0000-0000-0000-000000002653'::uuid,
+     '20000000-0000-0000-0000-000000002654'::uuid
+ );
+
+DELETE FROM sys_menu WHERE id = '20000000-0000-0000-0000-000000002651'::uuid;
