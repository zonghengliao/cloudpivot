<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>{{ doc_label }} {{ head.period_label }}</title>
<style>
/* ===========================================================================
   云枢 利润表 / 现金流量表模板（PDF-07，两张报表共用）
   ---------------------------------------------------------------------------
   两张报表的纸面结构是同一张「项目 / 本期金额 / 本年累计」三列表，差别只在
   行语义（一、二、三 这类分节标题、小计、合计）—— 所以共用一份模板 + 一份
   上下文结构体（`AmountReportContext`），行类型由 `row.kind` 决定视觉。

   行类型（`ReportRow.cls` / `kind`）：
     · section  —— 分节标题（现金流量表的「一、经营活动产生的现金流量」）
     · line     —— 明细行（按 level 缩进）
     · subtotal —— 小计（流入小计 / 流出小计）
     · total    —— 合计（营业利润 / 净利润 / 净增加额 / 期末余额）
     · note     —— 告警与说明（⚠ 未分类、口径提示），独占一行、不印金额

   打印四条铁律同 `report_balance.html.tera`（@page / thead 重复 /
   tr 不可腰斩 / tabular-nums）。
   =========================================================================== */
@page {
  size: A4 portrait;
  margin: 12mm 8mm 16mm 8mm;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: "Noto Sans SC", "Noto Sans CJK SC", sans-serif;
  font-size: 9pt;
  line-height: 1.35;
  color: #1f2329;
}

/* ---------- 表头 ---------- */
.head { margin-bottom: 5pt; }
.head-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  font-size: 9.5pt;
}
.head-top .company { font-weight: 700; letter-spacing: 0.5pt; }
h1.title {
  text-align: center;
  font-size: 16pt;
  font-weight: 700;
  letter-spacing: 6pt;
  margin: 4pt 0 5pt;
}
.meta {
  display: flex;
  justify-content: space-between;
  font-size: 8.5pt;
  color: #1f2329;
  padding: 0 2pt;
  margin-bottom: 3pt;
}

/* ---------- 报表主体 ---------- */
table.grid {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
}
table.grid thead { display: table-header-group; }
table.grid th,
table.grid td {
  border: 0.5pt solid #86909c;
  padding: 2.4pt 4pt;
  vertical-align: middle;
}
table.grid th {
  background: #f2f3f5;
  font-weight: 700;
  font-size: 8.5pt;
  text-align: center;
}
table.grid th.lbl { text-align: left; }
table.grid tr { break-inside: avoid; page-break-inside: avoid; }
td.lbl { text-align: left; }
td.num {
  text-align: right;
  white-space: nowrap;
  font-size: 8.5pt;
  font-variant-numeric: tabular-nums;
}

tr.is-section td { font-weight: 700; background: #f7f8fa; }
tr.is-subtotal td { background: #fafbfc; }
tr.is-subtotal td.lbl { font-weight: 700; padding-left: 10pt; }
tr.is-total td { font-weight: 700; background: #f2f3f5; }
tr.is-note td { color: #b32b25; font-size: 8pt; background: #fff1f0; }
td.l1 { font-weight: 700; }
td.l2 { padding-left: 10pt; }
td.l3 { padding-left: 20pt; }

/* ---------- 勾稽校验 ---------- */
.check {
  margin-top: 6pt;
  border: 0.5pt solid #86909c;
  padding: 4pt 6pt;
  font-size: 8.5pt;
  break-inside: avoid;
  page-break-inside: avoid;
}
.check .check-title { font-weight: 700; margin-bottom: 2pt; }
.check .line { margin: 1pt 0; }
.check.is-ok { border-color: #00a870; }
.check.is-ok .check-title { color: #00733f; }
.check.is-bad { border-color: #d54941; background: #fff1f0; }
.check.is-bad .check-title { color: #b32b25; }

/* ---------- 附注 ---------- */
.notes { margin-top: 5pt; font-size: 8pt; color: #4e5969; }
.notes .note-title { font-weight: 700; color: #1f2329; }
.notes div.note { margin: 1pt 0; }

/* ---------- 表尾签字 ---------- */
.sign {
  margin-top: 10pt;
  width: 100%;
  border-collapse: collapse;
  font-size: 9pt;
  break-inside: avoid;
  page-break-inside: avoid;
}
.sign td {
  border: 0.5pt solid #86909c;
  padding: 4pt 6pt 12pt;
  width: 33.33%;
}
.sign .label { color: #4e5969; }
.print-meta {
  margin-top: 4pt;
  font-size: 7.5pt;
  color: #86909c;
  display: flex;
  justify-content: space-between;
}
</style>
</head>
<body>
<div class="sheet">

  <!-- ==================== 表头：公司名 / 报表名 / 编制单位 / 期间 / 日期 / 单位 ==================== -->
  <div class="head">
    <div class="head-top">
      <span class="company">{{ head.company }}</span>
      <span class="unit">{{ head.unit_label }}</span>
    </div>
    <h1 class="title">{{ head.doc_title }}</h1>
    <div class="meta">
      <span>编制单位：{{ head.preparer }}</span>
      <span>期间：{{ head.period_label }}（{{ head.status_label }}）</span>
      <span>日期：{{ head.date_label }}</span>
    </div>
  </div>

  <!-- ==================== 主体：项目 / 本期金额 / 本年累计 ==================== -->
  <table class="grid">
    <colgroup>
      <col style="width:60%"><col style="width:20%"><col style="width:20%">
    </colgroup>
    <thead>
      <tr>
        <th class="lbl">项目</th>
        <th>{{ current_label }}</th>
        <th>{{ ytd_label }}</th>
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
      <tr class="{{ row.cls }}">
        {% if row.kind == "note" %}
        <td class="lbl" colspan="3">{{ row.label }}</td>
        {% else %}
        <td class="lbl {{ row.level_cls }}">{{ row.label }}</td>
        <td class="num">{{ row.current }}</td>
        <td class="num">{{ row.ytd }}</td>
        {% endif %}
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <!-- ==================== 勾稽校验 ==================== -->
  <div class="check {{ check.cls }}">
    <div class="check-title">{{ check.title }}</div>
    {% for line in check.lines %}<div class="line">{{ line }}</div>{% endfor %}
  </div>

  <!-- ==================== 附注（口径说明 / 告警原文） ==================== -->
  {% if has_notes %}
  <div class="notes">
    <div class="note-title">附注</div>
    {% for note in notes %}<div class="note">{{ loop.index }}. {{ note }}</div>{% endfor %}
  </div>
  {% endif %}

  <!-- ==================== 表尾：制表人 / 审核人 / 日期（手写） ==================== -->
  <table class="sign">
    <tr>
      <td><span class="label">制表人：</span></td>
      <td><span class="label">审核人：</span></td>
      <td><span class="label">日期：</span></td>
    </tr>
  </table>
  <div class="print-meta">
    <span>{{ doc_label }} · {{ doc_no }}</span>
    <span>打印时间 {{ printed_at }} · {{ engine }}</span>
  </div>

</div>
</body>
</html>
