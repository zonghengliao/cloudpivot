#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
# cloudpivot pre-push — 推送前的 L1 机械门禁（2026-11-09 立，2026-11-10 改为调 check.sh --fast）
#
# 为什么需要它：`scripts/check.sh` 一直是「靠人记得跑」。实测 HEAD 上
# `cargo clippy --all-targets -- -D warnings` 与 `cargo fmt --check` 都红着，
# 而提交照样推得上去 —— 门禁等于没有。pre-commit 只做密钥 / 库存写入口 / 暂存区
# rustfmt，拦不住 clippy 的语义类告警。这里把「编译期门禁」挪到 push 前，
# 做最后一道机械拦截。
#
# 判据只有一份：本钩子**不自己写检查**，直接调 `bash scripts/check.sh --fast`
# （L0 静态闸 + L1 编译与类型闸，≈2–3 分钟）。这样 check.sh 加一道闸，pre-push 自动跟上，
# 不会出现「钩子里的判据比 check.sh 旧」这种漂移 —— 那正是本次审查（5.7 门禁被绕过）的成因之一。
#
# 安装（每个克隆执行一次；本仓库已设置）：
#     bash scripts/git/install_hooks.sh      # 幂等：设置 core.hooksPath + chmod +x
# 校验：
#     git config --get core.hooksPath        # 应输出 .githooks
#
# 绕过（仅限紧急，且必须写进 PR / 卡内说明原因）：
#     SKIP_PREPUSH=1 git push                # 跳过整个 L0+L1
#     git push --no-verify                   # 绕过全部钩子（等价，但连 pre-commit 历史也不留痕）
#
# 设计：fail closed —— check.sh 不存在（比如只推了一个不含 scripts/ 的分支）时
#       拒绝推送并给出绕过方式，而不是「找不到就当绿」。
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 0

# ---------------------------------------------------------------------------
# 0. 只删除远端分支的 push（local_sha 全 0）没有内容要检查
# ---------------------------------------------------------------------------
skip_all=0
saw_ref=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_ref:-}" ] || continue
    saw_ref=1
    case "$local_sha" in
        *[!0]*) : ;;                 # 非全 0 → 真的在推内容
        *) skip_all=1 ;;             # 全 0 → 删除远端 ref
    esac
done
if [ "$saw_ref" = "1" ] && [ "$skip_all" = "1" ]; then
    echo "▶ pre-push：本次只删除远端分支，跳过编译期门禁"
    exit 0
fi

# ---------------------------------------------------------------------------
# 1. 紧急绕过开关
# ---------------------------------------------------------------------------
if [ "${SKIP_PREPUSH:-0}" = "1" ]; then
    echo "" >&2
    echo "! pre-push: SKIP_PREPUSH=1 → 跳过 L0+L1 门禁" >&2
    echo "  这条绕过必须在 PR / 卡里写明原因，否则事后无法解释" >&2
    echo "" >&2
    exit 0
fi

# ---------------------------------------------------------------------------
# 2. 门禁实体：scripts/check.sh --fast（判据唯一来源）
# ---------------------------------------------------------------------------
CHECK="$ROOT/scripts/check.sh"
if [ ! -f "$CHECK" ]; then
    echo "" >&2
    echo "✘ pre-push：找不到 $CHECK" >&2
    echo "  这个分支不含 scripts/check.sh，无法执行门禁。确认无误后可：SKIP_PREPUSH=1 git push" >&2
    exit 1
fi

echo "▶ pre-push：bash scripts/check.sh --fast（L0 静态闸 + L1 编译与类型闸）"
START=$(date +%s)
bash "$CHECK" --fast
rc=$?
END=$(date +%s)
if [ "$rc" -ne 0 ]; then
    echo "" >&2
    echo "✘ push 被拒绝：L0/L1 门禁未通过（退出码 $rc，耗时 $((END - START))s）" >&2
    echo "" >&2
    echo "  修法：按上面红掉的那一项的提示改（fmt → cd backend && cargo fmt；" >&2
    echo "        clippy → 看 lint 名与行号；typecheck → cd frontend && pnpm typecheck），" >&2
    echo "        改完重新 push 即可（无需重新 commit）。" >&2
    echo "" >&2
    echo "  紧急绕过（须在卡内写明理由）：SKIP_PREPUSH=1 git push" >&2
    exit 1
fi
END=$(date +%s)

echo ""
echo "✓ pre-push 门禁通过（L0+L1，耗时 $((END - START))s）"
exit 0
