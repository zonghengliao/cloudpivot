#!/usr/bin/env bash
# cloudpivot pre-commit
#
#   闸 1 · 密钥/口令明文不得进入 git（scripts/secret-scan.sh --staged）
#   闸 2 · 库存三本账不得绕过唯一写入口直写（scripts/verify/inventory_write_gate.py，P2-5B）
#   闸 3 · 暂存区里的 .rs 必须符合 rustfmt（2026-11-10 补，卡 t_2746ca53）
#
# 为什么闸 3 要在这里（而不是只靠 pre-push）：
#   2026-11-09 有人在 `.git/hooks/pre-commit` 里加过一份 rustfmt 检查，但同一天
#   `core.hooksPath` 切到了 `.githooks` —— **`.git/hooks/` 从此不再被执行**，
#   那份检查变成了死代码。「提交前自动跑 fmt」于是只存在于文档里，实际没有生效。
#   本闸只查**暂存区新增/修改的 .rs**（秒级，不跑全仓），是全仓 `cargo fmt --check`
#   （pre-push / check.sh 的 L1）的第一道便宜防线。
#
# 安装（每个克隆执行一次）：
#   bash scripts/git/install_hooks.sh      # 幂等：core.hooksPath=.githooks + chmod +x
#
# 设计：fail closed —— 扫描器不可用时拒绝提交，而不是静默放行。
# 紧急绕过：git commit --no-verify（关掉全部闸）；或 SKIP_SECRET_SCAN=1 /
#          SKIP_INVENTORY_GATE=1 / SKIP_RUSTFMT=1 只关掉其中一道（都会打 stderr）。
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
SCAN="$ROOT/scripts/secret-scan.sh"

if [ ! -x "$SCAN" ]; then
  chmod +x "$SCAN" 2>/dev/null || true
fi
if [ ! -f "$SCAN" ]; then
  echo "✘ pre-commit: 找不到 $SCAN，拒绝提交。" >&2
  echo "  如确需绕过（仅限紧急且已人工确认无密钥）：git commit --no-verify" >&2
  exit 1
fi

# 允许跳过：仅在明确知道自己在做什么时使用
if [ "${SKIP_SECRET_SCAN:-0}" = "1" ]; then
  echo "! pre-commit: SKIP_SECRET_SCAN=1，跳过 secret 扫描（已记录到 stderr）" >&2
else
  echo "▶ pre-commit secret 扫描（暂存区）"
  bash "$SCAN" --staged
  rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "" >&2
    echo "✘ 提交被拒绝：疑似密钥/口令明文。" >&2
    echo "  处理方式：把密钥移出代码，改由环境变量注入（cloudpivot 约定 NIK_MIDDLEWARE_AUTH_JWT_SECRET 等），" >&2
    echo "  密钥文件放 /etc/cloudpivot/<env>.env 并 chmod 600；详见 .gitleaks.toml 顶部说明。" >&2
    exit "$rc"
  fi
fi

# ---------------------------------------------------------------------------
# 闸 2 · 库存三本账唯一写入口（P2-5B）
#
# 为什么放在提交前：这道闸是「口径只有一份」的最后一道保险。库存写错不会抛异常，
# 只会在巡检里变成「账不对」，等发现时已经错了几个月。成本 ~1.4s（扫 341 个 .rs），
# 无数据库依赖，所以放在 pre-commit 完全划算。
# ---------------------------------------------------------------------------
GATE="$ROOT/scripts/verify/inventory_write_gate.py"
if [ "${SKIP_INVENTORY_GATE:-0}" = "1" ]; then
  echo "! pre-commit: SKIP_INVENTORY_GATE=1，跳过库存写入口闸（已记录到 stderr）" >&2
elif ! command -v python3 >/dev/null 2>&1; then
  echo "✘ pre-commit: 找不到 python3，无法执行库存写入口闸，拒绝提交。" >&2
  echo "  绕过（仅限紧急）：SKIP_INVENTORY_GATE=1 git commit …" >&2
  exit 1
elif [ ! -f "$GATE" ]; then
  echo "✘ pre-commit: 找不到 $GATE，拒绝提交。" >&2
  echo "  绕过（仅限紧急）：SKIP_INVENTORY_GATE=1 git commit …" >&2
  exit 1
else
  echo "▶ pre-commit 库存三本账唯一写入口闸"
  if ! python3 "$GATE"; then
    echo "" >&2
    echo "✘ 提交被拒绝：非测试代码里出现直写 biz_inventory / _location / _txn 的 SQL。" >&2
    echo "  改法：把写语句搬进 backend/src/business/erp/inventory_writer.rs 的语义函数" >&2
    echo "        （add_cost / subtract_cost / insert_txn …），业务侧只负责编排。" >&2
    echo "  说明：docs/后端二开指南.md §十四；测试夹具不受限（*_tests.rs / #[cfg(test)]）。" >&2
    exit 1
  fi
fi

# ---------------------------------------------------------------------------
# 闸 3 · 暂存区 .rs 的 rustfmt（卡 t_2746ca53）
#
# 只查本次**暂存**的新增/修改 .rs（`git diff --cached --diff-filter=ACM`），
# 全仓 `cargo fmt --check` 留给 pre-push 的 L1 —— 这里要的是「提交那一刻就拦住」，
# 而不是让人 push 到一半才发现。
# ---------------------------------------------------------------------------
if [ "${SKIP_RUSTFMT:-0}" = "1" ]; then
  echo "! pre-commit: SKIP_RUSTFMT=1，跳过 rustfmt 检查（已记录到 stderr）" >&2
elif ! command -v rustfmt >/dev/null 2>&1; then
  echo "ℹ pre-commit: 本机没有 rustfmt → 跳过（pre-push 的 cargo fmt --check 仍会兜住）"
else
  STAGED_RS="$(git -C "$ROOT" diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep '\.rs$' || true)"
  if [ -n "$STAGED_RS" ]; then
    BAD=""
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      [ -f "$ROOT/$f" ] || continue
      if ! rustfmt --check --edition 2024 "$ROOT/$f" >/dev/null 2>&1; then
        BAD="${BAD}  $f"$'\n'
      fi
    done <<< "$STAGED_RS"
    if [ -n "$BAD" ]; then
      echo "" >&2
      echo "✘ 提交被拒绝：以下暂存文件不符合 rustfmt" >&2
      printf '%s' "$BAD" >&2
      echo "" >&2
      echo "  修法：cd backend && cargo fmt      # 格式化全部（或用 rustfmt --edition 2024 <文件>）" >&2
      echo "  配置：backend/rustfmt.toml（max_width=120）" >&2
      exit 1
    fi
    echo "▶ pre-commit rustfmt：暂存区 $(printf '%s\n' "$STAGED_RS" | wc -l | tr -d ' ') 个 .rs 全部通过"
  fi
fi

exit 0
