{
  "name": "@cloudpivot/web",
  "version": "0.1.0",
  "private": true,
  "description": "云枢通用后台系统 前端",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.5.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/vue-tsc/bin/vue-tsc.js --noEmit",
    "typecheck:unit": "node --max-old-space-size=4096 ./node_modules/vue-tsc/bin/vue-tsc.js -p tsconfig.unit.json --noEmit",
    "test:e2e": "playwright test",
    "test:unit": "tsx --test \"tests/unit/**/*.test.ts\"",
    "test:e2e:report": "playwright show-report e2e-report",
    "check:palettes": "node scripts/check-palettes.mjs",
    "check": "pnpm check:palettes && pnpm typecheck && pnpm typecheck:unit"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "axios": "~1.15.0",
    "dagre": "^0.8.5",
    "dayjs": "~1.11.13",
    "echarts": "~5.4.3",
    "pdfjs-dist": "4.10.38",
    "pinia": "~3.0.4",
    "tdesign-icons-vue-next": "~0.4.4",
    "tdesign-vue-next": "~1.19.1",
    "vue": "~3.5.32",
    "vue-i18n": "~11.1.3",
    "vue-router": "~4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/dagre": "^0.7.54",
    "@types/node": "~22.15.0",
    "@vitejs/plugin-vue": "~5.2.4",
    "@vitejs/plugin-vue-jsx": "~4.2.0",
    "less": "~4.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "unplugin-auto-import": "~21.0.0",
    "unplugin-vue-components": "~32.0.0",
    "vite": "~6.3.4",
    "vite-plugin-compression": "~0.5.1",
    "vue-tsc": "~2.2.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "author": "Laoliu",
  "repository": {
    "type": "git",
    "url": "https://github.com/zonghengliao/cloudpivot.git"
  }
}
